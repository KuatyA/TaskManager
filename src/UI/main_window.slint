import { Palette, VerticalBox, HorizontalBox, Switch } from "std-widgets.slint";
import { TopPanel } from "top_panel.slint";
import { SidePanel } from "side_panel.slint";
import { TasksPanel } from "panels/tasks_panel.slint";
import { Logic } from "Logic/logic.slint";
import { SystemInfoPanel } from "panels/system_info_panel.slint";
import { SettingsPanel } from "panels/settings_panel.slint";
import { HardwareMetrics } from "panels/hardware_metrics.slint";
import { NetworkPanel } from "panels/network_panel.slint";
import { Disks } from "panels/disks.slint";


export component TaskManager inherits Window{
    callback settings-opened();
    background: Palette.background;
    preferred-height: 600px;
    min-height: 300px;
    preferred-width: 1000px;
    min-width: 500px;
    title: "C++ Task Manager";
    
    
    VerticalBox{
        spacing: 0px;
        padding: 0px;
        TopPanel{
            height: 50px;
            width: 100%;
        }
        HorizontalBox{
            spacing: 0px;
            padding: 0px;
            SidePanel{
                height: 100%;
                width: 200px;
            }
            Rectangle {
                TasksPanel{
                    visible: Logic.open-panel == 0;
                    height: 100%;
                    width: 100%;
                }
                SystemInfoPanel{
                    visible: Logic.open-panel == 1;
                    height: 100%;
                    width: 100%;
                }
                HardwareMetrics{
                    visible: Logic.open-panel == 2;
                    height: 100%;
                    width: 100%;
                }
                NetworkPanel{
                    visible: Logic.open-panel == 3;
                    height: 100%;
                    width: 100%;
                }
                Disks{
                    visible: Logic.open-panel == 4;
                    height: 100%;
                    width: 100%;
                }
                SettingsPanel{
                    visible: Logic.open-panel == 5;
                    height: 100%;
                    width: 100%;
                }
            }
        }
    }
}